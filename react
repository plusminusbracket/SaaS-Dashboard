      showNotification(`Payment successful for Invoice ${selectedInvoice.id}`);
    }, 2000);
  };

  const handleApproveDeliverable = (projId, delivId) => {
    setProjects(prev => prev.map(p => {
      if (p.id === projId) {
        return {
          ...p,
          deliverables: p.deliverables.map(d => d.id === delivId ? { ...d, status: 'Approved' } : d)
        };
      }
      return p;
    }));
    addAuditLog('Deliverable Approved', `Deliverable approved in project ${projId}`);
    showNotification('Deliverable status updated to Approved.');
  };

  const handleToggleMilestone = (projId, milestoneId) => {
    setProjects(prev => prev.map(p => {
      if (p.id === projId) {
        return {
          ...p,
          milestones: p.milestones.map(m => {
            if (m.id === milestoneId) {
              const nextStatus = m.status === 'Completed' ? 'In Progress' : 'Completed';
              return { ...m, status: nextStatus };
            }
            return m;
          })
        };
      }
      return p;
    }));
