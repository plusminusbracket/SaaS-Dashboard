                          <h4 className="font-semibold text-slate-100 text-sm">{proj.name}</h4>
                          <p className="text-xs text-slate-400">Lead PM: {proj.manager} • Due {proj.deadline}</p>
                        </div>
                        <span className="text-xs px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-400 font-medium border border-blue-500/20">
                          {proj.status}
                        </span>
                      </div>

                      {/* Progress Bar */}
                      <div>
                        <div className="flex justify-between text-xs font-medium text-slate-400 mb-1">
                          <span>Overall Progress</span>
                          <span className="text-white">{proj.progress}%</span>
                        </div>
                        <div className="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                          <div 
                            className="h-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-500"
                            style={{ width: `${proj.progress}%` }}
                          ></div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Audit Activity & Security Log */}
              <div className="bg-slate-900/60 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
                <div>
                  <div className="flex items-center justify-between mb-4">
                    <h3 className="font-bold text-white text-base flex items-center gap-2">
                      <ShieldAlert className="w-4 h-4 text-indigo-400" /> Audit Log
                    </h3>
                    <span className="text-[11px] text-slate-400">Real-time Feed</span>
                  </div>

                  <div className="space-y-3">
                    {auditLogs.slice(0, 5).map(log => (
                      <div key={log.id} className="text-xs p-3 rounded-xl bg-slate-900/90 border border-slate-800/80 space-y-1">
                        <div className="flex justify-between items-center text-slate-300 font-medium">
                          <span>{log.action}</span>
                          <span className="text-[10px] text-slate-500">{log.time}</span>
                        </div>
                        <p className="text-slate-400 text-[11px] leading-tight">{log.details}</p>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="mt-4 pt-3 border-t border-slate-800/80 text-center">
                  <p className="text-[11px] text-slate-400">SOC2 Type II Encrypted Audit Trail Active</p>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* PROJECT STATUS TAB */}
        {activeTab === 'projects' && (
          <div className="p-6 space-y-6">
            <div className="flex flex-wrap items-center justify-between gap-4">
              <div>
                <h3 className="text-xl font-bold text-white">Project Status & Deliverables</h3>
                <p className="text-slate-400 text-xs mt-0.5">Track milestones, pending reviews, and delivery progress.</p>
              </div>

              {role === 'admin' && (
                <button 
                  onClick={() => showNotification("Admin action: Created a new project tracking workflow")}
                  className="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl flex items-center gap-2 shadow"
                >
                  <Plus className="w-4 h-4" /> Create Milestone
                </button>
              )}
            </div>

            <div className="space-y-6">
              {projects.map((project) => (
                <div key={project.id} className="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-6">
                  {/* Header */}
                  <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
                    <div>
                      <div className="flex items-center gap-3">
                        <h4 className="text-lg font-bold text-white">{project.name}</h4>
                        <span className="text-xs px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 font-medium">
                          {project.status}
                        </span>
                      </div>
                      <p className="text-xs text-slate-400 mt-1">
                        Client: <strong className="text-slate-300">{project.client}</strong> • Budget: ${project.budget.toLocaleString()} • Target Completion: {project.deadline}
                      </p>
                    </div>

                    <div className="w-full md:w-64">
                      <div className="flex justify-between text-xs font-semibold mb-1.5">
                        <span className="text-slate-400">Completion</span>
                        <span className="text-blue-400">{project.progress}%</span>
                      </div>
                      <div className="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden">
                        <div className="h-full bg-blue-500 rounded-full transition-all" style={{ width: `${project.progress}%` }}></div>
                      </div>
                    </div>
                  </div>

                  {/* Milestones Grid */}
                  <div>
                    <h5 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-2">
                      <Clock className="w-4 h-4 text-indigo-400" /> Key Milestones Timeline
                    </h5>
                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                      {project.milestones.map((m) => (
                        <div 
                          key={m.id} 
                          onClick={() => handleToggleMilestone(project.id, m.id)}
                          className={`p-3.5 rounded-xl border transition-all cursor-pointer ${
                            m.status === 'Completed' 
                              ? 'bg-slate-950/80 border-emerald-500/30 text-emerald-300' 
                              : m.status === 'In Progress'
                              ? 'bg-blue-950/20 border-blue-500/40 text-blue-300'
                              : 'bg-slate-950/40 border-slate-800 text-slate-400'
                          }`}
                        >
                          <div className="flex items-center justify-between mb-1">
                            <span className="text-[11px] font-semibold">{m.date}</span>
                            {m.status === 'Completed' ? (
                              <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                            ) : m.status === 'In Progress' ? (
                              <RefreshCw className="w-4 h-4 text-blue-400 animate-spin" />
                            ) : (
                              <Clock className="w-4 h-4 text-slate-500" />
                            )}
                          </div>
                          <p className="text-xs font-semibold text-slate-100">{m.title}</p>
                          <p className="text-[10px] mt-2 capitalize font-mono text-slate-400">{m.status}</p>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Deliverables & Sign-offs */}
                  <div>
                    <h5 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-2">
                      <CheckSquare className="w-4 h-4 text-emerald-400" /> Deliverables & Client Approvals
                    </h5>
                    <div className="space-y-2">
                      {project.deliverables.map((del) => (
                        <div key={del.id} className="flex flex-wrap items-center justify-between gap-3 p-3 rounded-xl bg-slate-950 border border-slate-800">
                          <div className="flex items-center gap-3">
                            <FileCode className="w-4 h-4 text-slate-400" />
                            <span className="text-xs font-medium text-slate-200">{del.title}</span>
                          </div>

                          <div className="flex items-center gap-3">
                            <span className={`text-[11px] px-2.5 py-0.5 rounded-full font-medium ${
                              del.status === 'Approved' 
                                ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                                : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                            }`}>
                              {del.status}
                            </span>

                            {role === 'client' && del.status !== 'Approved' && (
                              <button
                                onClick={() => handleApproveDeliverable(project.id, del.id)}
                                className="px-3 py-1 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg transition"
                              >
                                Approve Deliverable
                              </button>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* SECURE FILE SHARING TAB */}
        {activeTab === 'files' && (
          <div className="p-6 space-y-6">
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div>
                <h3 className="text-xl font-bold text-white flex items-center gap-2">
                  <FolderLock className="w-5 h-5 text-indigo-400" /> Secure File Vault
                </h3>
                <p className="text-slate-400 text-xs mt-0.5">Encrypted document storage and permission-controlled asset sharing.</p>
              </div>

              {/* Upload Drop Zone Simulation Button */}
              <label className="cursor-pointer px-4 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-xs font-semibold rounded-xl flex items-center gap-2 shadow shadow-blue-500/20 transition">
                <Upload className="w-4 h-4" /> Upload Secure File
                <input type="file" className="hidden" onChange={handleFileUpload} />
              </label>
            </div>

            {/* Folder Tabs & Search Filters */}
            <div className="flex flex-col sm:flex-row gap-4 items-center justify-between bg-slate-900 border border-slate-800 p-3 rounded-2xl">
