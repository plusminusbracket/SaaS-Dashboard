        folder: selectedFolderFilter === 'All' ? 'General Docs' : selectedFolderFilter,
        uploadedBy: role === 'client' ? 'Client Upload' : 'Admin Manager',
        date: new Date().toISOString().split('T')[0],
        access: role === 'client' ? 'Shared with Agency' : 'Shared with Client',
        downloads: 0
